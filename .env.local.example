# Environment Variables for Azam Reka
# Add these to Vercel Project Settings → Environment Variables
# DO NOT put real values in this file or commit real secrets to GitHub

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=azamreka

# Resend Email Service
RESEND_API_KEY=your_resend_api_key_here

# ToyyibPay (Payment Gateway)
TOYYIBPAY_API_KEY=your_toyyibpay_api_key_here
TOYYIBPAY_CATEGORY_CODE=your_category_code_here

# Admin dashboard password (for /admin.html order tracking updates)
ADMIN_PASSWORD=choose_a_strong_password_here

# Zoho Books (for automatic Sales Order creation on payment)
ZOHO_CLIENT_ID=your_zoho_self_client_id
ZOHO_CLIENT_SECRET=your_zoho_self_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORGANIZATION_ID=843276944
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# EasyParcel (shipping rate check, order booking, tracking)
# Real OAuth 2.0 (Authorization Code grant) — same shape as the Zoho vars
# above, not a single API key. Register an app at EasyParcel's Developer Hub
# to get CLIENT_ID/CLIENT_SECRET, then get REFRESH_TOKEN via the one-time
# "click Allow" flow described in api/_lib/easyparcel.js's file header.
# If you previously set EASYPARCEL_ID / EASYPARCEL_KEY / EASYPARCEL_API_KEY /
# EASYPARCEL_ENV in Vercel, remove them — none of those correspond to
# anything in the real API.
EASYPARCEL_CLIENT_ID=your_easyparcel_client_id
EASYPARCEL_CLIENT_SECRET=your_easyparcel_client_secret
EASYPARCEL_REFRESH_TOKEN=your_easyparcel_refresh_token

# Vercel auto-provides this, but if testing locally:
VERCEL_URL=https://azamreka.com
